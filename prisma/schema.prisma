generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  clerkUserId   String?   @unique // clerk user id, optional for NextAuth
  email         String    @unique
  name          String?
  imageUrl      String?
  password      String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  transactions  Transaction[]
  bankAccounts  BankAccount[]
  budgets       Budget[]
  categoryBudgets CategoryBudget[]
  goals         Goal[]
  goalContributions GoalContribution[]
  trips         Trip[]
  friends       Friend[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("users")
}

model BankAccount {
  id           String        @id @default(uuid())
  name         String
  type         AccountType
  balance      Decimal       @default(0) // will ask inital balance while creating an account
  isDefault    Boolean       @default(false)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@map("bank_accounts")
}

model Transaction {
  id                String            @id @default(uuid())
  type             TransactionType
  amount           Decimal
  description      String?
  date             DateTime
  category         String           
  receiptUrl       String?
  isRecurring      Boolean           @default(false)
  recurringInterval RecurringInterval? // Only used if isRecurring is true
  nextRecurringDate DateTime?         // Next date for recurring transaction
  lastProcessed    DateTime?         // Last time this recurring transaction was processed
  status           TransactionStatus  @default(COMPLETED)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountId    String
  bankAccount      BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([bankAccountId])
  @@map("transactions")
}

model Budget {
  id          String       @id @default(uuid())
  amount      Decimal
  lastAlertSent DateTime?  // Track when the last alert was sent
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@map("budgets")
}

model CategoryBudget {
  id          String    @id @default(uuid())
  category    String
  amount      Decimal
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, category])
  @@index([userId])
  @@map("category_budgets")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionStatus { 
  PENDING
  COMPLETED
  FAILED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SplitType {
  NONE
  EQUAL
}

model Goal {
  id            String      @id @default(uuid())
  name          String
  targetAmount  Decimal
  currentAmount Decimal     @default(0)
  targetDate    DateTime
  color         String?     
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contributions GoalContribution[]

  @@index([userId])
  @@map("goals")
}

model GoalContribution {
  id             String   @id @default(uuid())
  amount         Decimal  // Positive for addition, negative for withdrawal
  idempotencyKey String   @unique // Prevents duplicate submissions
  goalId         String
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId         String   // Security enforcement
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([goalId])
  @@index([userId])
  @@map("goal_contributions")
}

model Trip {
  id          String      @id @default(uuid())
  name        String
  destination String
  budget      Decimal
  startDate   DateTime?
  endDate     DateTime?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  places      TripPlace[]
  expenses    TripExpense[]

  @@index([userId])
  @@map("trips")
}

model TripPlace {
  id            String   @id @default(uuid())
  name          String
  estimatedCost Decimal  @default(0)
  visited       Boolean  @default(false)
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([tripId])
  @@map("trip_places")
}

model TripExpense {
  id          String   @id @default(uuid())
  title       String
  amount      Decimal
  paidBy      String?  // e.g. "Me", "Friend 1", "Friend 2"
  category    String   @default("other-expense")
  splitType   SplitType @default(NONE)
  splitCount  Int?
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  splits      ExpenseSplitEntry[]

  @@index([tripId])
  @@map("trip_expenses")
}

model Friend {
  id        String   @id @default(uuid())
  name      String
  upiId     String?
  phone     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  splitEntries ExpenseSplitEntry[]

  @@index([userId])
  @@map("friends")
}

model ExpenseSplitEntry {
  id          String   @id @default(uuid())
  amount      Decimal
  settled     Boolean  @default(false)
  settledAt   DateTime?

  friendName  String
  friendUpiId String?

  expenseId   String
  expense     TripExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  friendId    String?
  friend      Friend?     @relation(fields: [friendId], references: [id], onDelete: SetNull)

  createdAt   DateTime    @default(now())

  @@index([expenseId])
  @@index([friendId])
  @@map("expense_split_entries")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@map("sessions")
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
  @@map("verification_tokens")
}
